{
  "manifest_version": 2,
  "id": "NetaJuutilainen.mai-mouth-filter",
  "version": "1.0.1",
  "name": "麦麦不要说辣个啦",
  "description": "麦麦不要说辣个啦——Neuro-sama 式嘴替打码：麦麦回复发出之前检查正文，命中的脏话/过分词句替换为随机占位符（*已过滤* / *Filtered*，每个消音位独立随机），并有一定概率触发「整句吞噬」——整条回复直接换成一个单独的占位符，模拟整句消音。词表驱动、零 token 成本；精确词（不分英文大小写）+ 正则两类规则，词表在 WebUI 与 data 目录均可增删，热重载即时生效；正文被全部过滤时改发兜底替代语；命中记录进日志（不落原文），便于回看误杀。",
  "author": {
    "name": "NetaJuutilainen",
    "url": "https://github.com/NetaJuutilainen"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/NetaJuutilainen/maibot-plugin-mouth-filter"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "capabilities": [],
  "display": { "icon": { "type": "local", "value": "assets/icon.png" } },
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "behavior",
  "changelog": "CHANGELOG.md"
}